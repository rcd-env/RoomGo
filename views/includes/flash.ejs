<% if(success && success.length) { %>
<div
  class="alert alert-success alert-dismissible fade show position-fixed bottom-0 start-25 mb-3 z-3"
  role="alert"
  style="min-width: 300px"
>
  <strong><%= success %></strong>
  <button
    type="button"
    class="btn-close"
    data-bs-dismiss="alert"
    aria-label="Close"
  ></button>
</div>
<% } %> <% if(error && error.length) { %>
<div
  class="alert alert-danger alert-dismissible fade show position-fixed bottom-0 start-25 mb-3 z-3"
  role="alert"
  style="min-width: 300px"
>
  <strong><%= error %></strong>
  <button
    type="button"
    class="btn-close"
    data-bs-dismiss="alert"
    aria-label="Close"
  ></button>
</div>
<% } %>

<script>
  setTimeout(() => {
    const alerts = document.querySelectorAll(".alert");
    alerts.forEach((alert) => {
      alert.classList.remove("show");
      alert.classList.add("hide");
    });
  }, 5000);
</script>
