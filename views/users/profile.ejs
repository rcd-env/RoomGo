<% layout('layouts/boilerplate') -%>

<style>
  body {
    background-color: #ffffff;
    color: #000000;
  }

  .profile-card-item {
    background-color: #fff;
    border: 1.5px solid #000;
    border-radius: 12px;
    transition: 0.2s ease-in-out;
  }

  .profile-card-item:hover {
    opacity: 0.5;
  }

  .listing-img {
    width: 40px !important;
    height: 40px !important;
    object-fit: cover;
    border-radius: 6px;
    border: 1px solid #000;
  }

  /* .cancel-booking-btn {
    border: 1.5px solid #000;
    color: #000;
    transition: 0.2s;
  }

  .cancel-booking-btn:hover {
    background-color: #000;
    color: #fff;
  } */

  h5,
  h6,
  p {
    margin: 0;
  }

  hr {
    border-top: 1.5px solid #000;
  }
  .listing-img {
    width: 40px !important;
    height: 40px !important;
    object-fit: cover !important;
    border-radius: 6px;
    display: block;
  }
  .card .listing-img {
    width: 60px !important;
    height: 60px !important;
    margin-bottom: 0 !important;
  }
</style>

<body>
  <main class="container py-5">
    <div class="row justify-content-center">
      <div class="col-12">
        <div class="mb-4">
          <div class="d-flex align-items-center mb-4">
            <div
              class="rounded-circle bg-black text-white d-flex justify-content-center align-items-center"
              style="width: 60px; height: 60px; font-size: 1.5rem"
            >
              <%= currUser.username[0].toUpperCase() %>
            </div>
            <div class="ms-3">
              <h4><%= currUser.username %></h4>
              <p class="text-muted"><%= currUser.email %></p>
            </div>
          </div>

          <hr />

          <!-- Your Hosted Spots -->
          <h5 class="mb-3">Your Hosted Spots</h5>
          <% if (hostedSpots && hostedSpots.length > 0) { %> <%
          hostedSpots.forEach(spot => { %>
          <a
            href="/lists/<%= spot._id %>"
            class="text-decoration-none text-black"
          >
            <div class="card mb-3 profile-card-item">
              <div class="d-flex align-items-center gap-3">
                <img
                  src="<%= spot.image.url %>"
                  alt="Spot Image"
                  class="listing-img"
                  height="40"
                  width="40"
                />
                <div class="flex-grow-1">
                  <h6><%= spot.title %></h6>
                  <p class="text-muted small">
                    <%= spot.location %> • <%= spot.country %>
                  </p>
                </div>
                <div class="text-end">
                  <p class="fw-semibold mb-0">Price</p>
                  <p class="mb-0">₹<%= spot.price.toLocaleString("en-IN") %></p>
                </div>
              </div>
            </div>
          </a>
          <hr />
          <% }) %> <% } else { %>
          <div class="alert alert-info">No hosted spots yet.</div>
          <hr />
          <% } %>

          <!-- Your Bookings -->
          <h5 class="mb-3">Your Bookings</h5>
          <% if (bookings && bookings.length > 0) { %> <%
          bookings.forEach(booking => { %>
          <div class="row mb-3">
            <div class="col-12 col-lg-10">
              <a
                href="/lists/<%= booking.list._id %>"
                class="text-decoration-none text-black"
              >
                <div class="card profile-card-item">
                  <div class="d-flex align-items-center gap-3">
                    <img
                      src="<%= booking.list.image.url %>"
                      alt="Booking Image"
                      class="listing-img"
                    />
                    <div class="flex-grow-1">
                      <h6><%= booking.list.title %></h6>
                      <p class="text-muted small">
                        Check-in: <%=
                        booking.checkIn.toLocaleDateString("en-IN") %>.
                      </p>
                      <p class="text-muted small">
                        Check-out: <%=
                        booking.checkOut.toLocaleDateString("en-IN") %>
                      </p>
                    </div>
                    <div class="text-end">
                      <p class="text-muted small">total</p>
                      <p class="fw-bold">
                        ₹<%= booking.totalPrice.toLocaleString("en-IN") %>
                      </p>
                    </div>
                  </div>
                </div>
              </a>
            </div>
            <div class="col-12 col-lg-2 mt-2 mt-lg-0 d-flex align-items-center">
              <button
                class="btn btn-outline-danger cancel-booking-btn w-100 py-lg-3"
                data-list-id="<%= booking.list._id %>"
                data-booking-id="<%= booking._id %>"
              >
                Cancel Booking
              </button>
            </div>
          </div>
          <hr />
          <% }) %> <% } else { %>
          <div class="alert alert-info">No bookings yet.</div>

          <% } %>
        </div>
      </div>
    </div>
  </main>
  <!-- Cancel Booking Confirmation Modal -->
  <div
    class="modal fade"
    id="cancelBookingModal"
    tabindex="-1"
    aria-labelledby="cancelBookingLabel"
    aria-hidden="true"
  >
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content bg-white text-black border-dark">
        <div class="modal-header border-0">
          <h5 class="modal-title" id="cancelBookingLabel">
            Confirm Cancellation
          </h5>
          <button
            type="button"
            class="btn-close"
            data-bs-dismiss="modal"
            aria-label="Close"
          ></button>
        </div>
        <div class="modal-body">
          Are you sure you want to cancel this booking? This action cannot be
          undone.
        </div>
        <div class="modal-footer border-0">
          <button
            type="button"
            class="btn btn-secondary"
            data-bs-dismiss="modal"
          >
            Keep Booking
          </button>
          <form id="cancelBookingForm" action="" method="POST">
            <button type="submit" class="btn btn-danger">
              Yes, Cancel Booking
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</body>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const cancelButtons = document.querySelectorAll(".cancel-booking-btn");
    const cancelForm = document.getElementById("cancelBookingForm");
    const cancelModalElement = document.getElementById("cancelBookingModal");

    cancelButtons.forEach((button) => {
      button.addEventListener("click", function (e) {
        e.preventDefault();
        e.stopPropagation();

        const listId = this.getAttribute("data-list-id");
        const bookingId = this.getAttribute("data-booking-id");
        cancelForm.action = `/lists/${listId}/book/cancel/${bookingId}`;

        const cancelModal = new bootstrap.Modal(cancelModalElement);
        cancelModal.show();
      });
    });
  });
</script>
