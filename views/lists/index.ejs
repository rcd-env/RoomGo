<% layout('layouts/boilerplate') -%>
<body>
  <div
    class="form-check-reverse form-switch"
    style="margin-top: 2rem; margin-right: 80%"
  >
    <input
      class="form-check-input"
      type="checkbox"
      role="switch"
      id="switchCheckDefault"
    />
    <label class="form-check-label" for="switchCheckDefault"
      >Display Price with Taxes
    </label>
  </div>
  <main class="cards-main mt-1 mt-md-0">
    <% lists.forEach(list => { %>
    <a href="/lists/<%=list._id%>">
      <div class="card card-each" style="width: 20rem">
        <img src="<%=list.image.url%>" class="card-img-top" alt="..." />
        <div class="card-body" style="gap: 0">
          <h5 class="card-title"><%=list.title%></h5>
          <p class="card-price">
            ₹<%=list.price.toLocaleString("en-IN")%> &bull; night &nbsp;
            <i style="font-weight: normal; opacity: 0.6">+ 18% GST</i>
          </p>
        </div>
      </div></a
    >
    <% });%>
  </main>
</body>
<script>
  let taxSwitch = document.getElementById("switchCheckDefault");
  taxSwitch.addEventListener("change", function () {
    let prices = document.querySelectorAll(".card-price");

    prices.forEach((priceElement) => {
      let priceText = priceElement.innerHTML;

      if (taxSwitch.checked) {
        // Show price with GST
        if (priceText.includes("+ 18% GST")) {
          // Extract the base price number
          let basePrice = parseFloat(
            priceText.match(/₹([\d,]+)/)[1].replace(/,/g, "")
          );
          let totalPrice = Math.round(basePrice * 1.18);
          priceElement.innerHTML = `₹${totalPrice.toLocaleString(
            "en-IN"
          )} &bull; night &nbsp;<i style="font-weight: normal; opacity: 0.6">Total (incl. GST)</i>`;
        }
      } else {
        // Show base price
        if (priceText.includes("Total (incl. GST)")) {
          // Extract the total price and calculate base price
          let totalPrice = parseFloat(
            priceText.match(/₹([\d,]+)/)[1].replace(/,/g, "")
          );
          let basePrice = Math.round(totalPrice / 1.18);
          priceElement.innerHTML = `₹${basePrice.toLocaleString(
            "en-IN"
          )} &bull; night &nbsp;<i style="font-weight: normal; opacity: 0.6">+ 18% GST</i>`;
        }
      }
    });
  });
</script>
