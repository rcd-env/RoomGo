<% layout('layouts/boilerplate') -%>

<body>
  <div class="row-1 mt-5 mb-5">
    <div class="col-10 offset-1 col-md-6 offset-md-3">
      <form
        action="/lists/<%=list._id%>"
        method="post"
        class="needs-validation"
        enctype="multipart/form-data"
        novalidate
      >
        <div class="mb-3 mt-2">
          <label for="title" class="form-label">Title</label>
          <input
            class="form-control"
            type="text"
            id="title"
            name="title"
            placeholder="Add a catchy title : "
            value="<%=list.title%>"
            required
          />
          <div class="invalid-feedback">Please provide us the Title.</div>
        </div>
        <div class="mb-3">
          <label for="description" class="form-label">Description</label>
          <textarea
            class="form-control"
            id="description"
            name="description"
            required
          >
<%=list.description%></textarea
          >
          <div class="invalid-feedback">Please provide us the Description.</div>
        </div>

        <div class="mb-3">
          <label for="imageurl" class="form-label">Image</label>
          <input class="form-control" id="imageurl" type="file" name="image" />
          <button
            type="button"
            id="previewBtn"
            class="btn btn-outline-dark mt-2"
          >
            Preview Previous Image
          </button>
          <div
            id="imagePreviewContainer"
            style="display: none; margin-top: 10px"
          >
            <img
              id="imagePreview"
              src="<%= list.image.url %>"
              alt="Current Image"
              style="
                max-width: 100%;
                max-height: 200px;
                border-radius: 8px;
                box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
              "
            />
          </div>
        </div>
        <div class="row">
          <div class="mb-3 col-md-5">
            <label for="price" class="form-label">Price</label>
            <input
              class="form-control"
              id="price"
              type="number"
              name="price"
              placeholder="Eg. 25000"
              value="<%=list.price%>"
              required
            />
            <div class="invalid-feedback">Please enter a valid Price.</div>
          </div>
          <div class="mb-3 col-md-7">
            <label for="country" class="form-label">Country</label>
            <input
              class="form-control"
              id="country"
              type="text"
              name="country"
              placeholder="Eg. India"
              value="<%=list.country%>"
              required
            />
            <div class="invalid-feedback">Please provide us the Country.</div>
          </div>
        </div>
        <div class="mb-3">
          <label for="location" class="form-label">Location</label>
          <input
            class="form-control"
            id="location"
            type="text"
            name="location"
            placeholder="Eg. Kolkata, West Bengal"
            value="<%=list.location%>"
            required
          />
          <div class="invalid-feedback">Please provide us the Location.</div>
        </div>
        <div class="row">
          <div class="col-12">
            <button class="btn btn-outline-dark w-100">Update</button>
          </div>
        </div>
      </form>
    </div>
  </div>
</body>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const previewBtn = document.getElementById("previewBtn");
    const imagePreviewContainer = document.getElementById(
      "imagePreviewContainer"
    );
    previewBtn.addEventListener("click", function () {
      if (imagePreviewContainer.style.display === "none") {
        imagePreviewContainer.style.display = "block";
        previewBtn.textContent = "Hide Image Preview";
      } else {
        imagePreviewContainer.style.display = "none";
        previewBtn.textContent = "Preview Previous Image";
      }
    });
  });
</script>
