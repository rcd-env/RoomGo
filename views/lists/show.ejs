<% layout('layouts/boilerplate') -%>
<body>
  <!-- Booking Modal -->
  <div
    class="modal fade"
    id="bookingModal"
    tabindex="-1"
    aria-labelledby="bookingModalLabel"
    aria-hidden="true"
  >
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="bookingModalLabel">
            Book <%= list.title %>
          </h5>
          <button
            type="button"
            class="btn-close"
            data-bs-dismiss="modal"
            aria-label="Close"
          ></button>
        </div>
        <div class="modal-body">
          <form
            id="bookingForm"
            action="/lists/<%= list._id %>/book"
            method="POST"
          >
            <div class="row">
              <div class="col-md-6 mb-3">
                <label for="checkIn" class="form-label">Check-in Date</label>
                <input
                  type="date"
                  class="form-control"
                  id="checkIn"
                  name="checkIn"
                  required
                  min="<%= new Date().toISOString().split('T')[0] %>"
                />
                <div class="invalid-feedback">
                  Please select a check-in date
                </div>
              </div>
              <div class="col-md-6 mb-3">
                <label for="checkOut" class="form-label">Check-out Date</label>
                <input
                  type="date"
                  class="form-control"
                  id="checkOut"
                  name="checkOut"
                  required
                  min="<%= new Date().toISOString().split('T')[0] %>"
                />
                <div class="invalid-feedback">
                  Please select a check-out date
                </div>
              </div>
            </div>

            <div class="mb-4">
              <h6 class="fw-bold mb-3">Price Details</h6>
              <div class="d-flex justify-content-between">
                <span
                  >₹<%= list.price.toLocaleString("en-IN") %> ×
                  <span id="nightsCount">1</span> night(s)</span
                >
                <span id="subtotal"
                  >₹<%= list.price.toLocaleString("en-IN") %></span
                >
              </div>
              <div class="d-flex justify-content-between">
                <span>GST (18%)</span>
                <span id="gstAmount"
                  >₹<%= Math.round(list.price * 0.18).toLocaleString("en-IN")
                  %></span
                >
              </div>
              <hr />
              <div class="d-flex justify-content-between fw-bold">
                <span>Total</span>
                <span id="totalPrice"
                  >₹<%= Math.round(list.price * 1.18).toLocaleString("en-IN")
                  %></span
                >
              </div>
            </div>
          </form>
        </div>
        <div class="modal-footer">
          <button
            type="button"
            class="btn btn-secondary"
            data-bs-dismiss="modal"
          >
            Cancel
          </button>
          <button type="submit" form="bookingForm" class="btn btn-success">
            Confirm Booking
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Content -->
  <div class="row-1 mt-4">
    <div class="col-10 offset-1">
      <div class="card">
        <!-- Responsive Row for Large Screens -->
        <div class="row g-4 align-items-center">
          <!-- Image Column -->
          <div class="col-12 col-md-6">
            <img
              src="<%= list.image.url %>"
              class="img-fluid rounded show-img"
              alt="..."
              style="
                height: 300px !important;
                width: 100%;
                object-fit: cover;
                object-position: center;
              "
            />
          </div>

          <!-- Details Column -->
          <div class="col-12 col-md-6">
            <div class="card-body p-0">
              <p class="show-title" style="font-size: 2rem">
                <b><%= list.title %></b>
              </p>
              <p
                class="card-text show-text d-block mb-1"
                style="text-align: justify"
              >
                &#10075; <i><%= list.description %></i>
              </p>

              <p class="mb-1">
                <b>₹ <%= list.price.toLocaleString("en-IN") %></b>
              </p>
              <p class="mb-1">
                <%= list.location %> &bull; <%= list.country %>
              </p>

              <p style="font-size: 1rem">
                <% if (currUser && currUser._id.equals(list.owner._id)) { %>
                &#9999; Owner : You <% } else { %> &#9999; Owner : <%=
                list.owner.username %> <% } %>
              </p>
            </div>
          </div>
        </div>

        <!-- Buttons for owner -->
        <div class="row mt-3">
          <% if (currUser && currUser._id.equals(list.owner._id)) { %>
          <div class="col-12 col-md-4 mb-2">
            <form action="/lists/<%= list._id %>/edit">
              <button class="btn btn-outline-info w-100">Edit</button>
            </form>
          </div>
          <!-- Delete Button that triggers modal -->
          <div class="col-12 col-md-8">
            <button
              type="button"
              class="btn btn-outline-danger w-100"
              data-bs-toggle="modal"
              data-bs-target="#confirmDeleteModal"
            >
              Delete
            </button>
          </div>

          <!-- Delete Confirmation Modal -->
          <div
            class="modal fade"
            id="confirmDeleteModal"
            tabindex="-1"
            aria-labelledby="confirmDeleteLabel"
            aria-hidden="true"
          >
            <div class="modal-dialog modal-dialog-centered">
              <div class="modal-content bg-white text-black border-dark">
                <div class="modal-header border-0">
                  <h5 class="modal-title" id="confirmDeleteLabel">
                    Confirm Deletion
                  </h5>
                  <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                    aria-label="Close"
                  ></button>
                </div>
                <div class="modal-body">
                  Are you sure you want to delete this listing? This action
                  cannot be undone.
                </div>
                <div class="modal-footer border-0">
                  <button
                    type="button"
                    class="btn btn-secondary"
                    data-bs-dismiss="modal"
                  >
                    Cancel
                  </button>

                  <!-- Actual delete form -->
                  <form action="/lists/<%= list._id %>/delete" method="POST">
                    <button type="submit" class="btn btn-danger">
                      Yes, Delete
                    </button>
                  </form>
                </div>
              </div>
            </div>
          </div>

          <% } else { %>
          <div class="col-12 mb-2">
            <button
              class="btn btn-outline-dark w-100"
              data-bs-toggle="modal"
              data-bs-target="#bookingModal"
            >
              Book Now (₹<%= Math.round(list.price *
              1.18).toLocaleString("en-IN") %> incl. GST)
            </button>
          </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <hr />

  <div class="col-10 offset-1 mb-4">
    <h4>Leave A Review</h4>
    <hr />
    <% if (currUser) { %>
    <form
      action="/lists/<%= list._id %>/reviews"
      method="post"
      class="needs-validation"
      novalidate
    >
      <fieldset class="starability-checkmark mb-3">
        <legend style="font-size: 16px">Rating:</legend>
        <input
          type="radio"
          id="no-rate"
          class="input-no-rate"
          name="rating"
          value="0"
          checked
          aria-label="No rating."
        />
        <input type="radio" id="first-rate1" name="rating" value="1" />
        <label for="first-rate1" data-bs-toggle="tooltip" title="Terrible"
          >1 star</label
        >
        <input type="radio" id="first-rate2" name="rating" value="2" />
        <label
          for="first-rate2"
          data-bs-toggle="tooltip"
          data-bs-placement="bottom"
          title="Average"
          >2 stars</label
        >
        <input type="radio" id="first-rate3" name="rating" value="3" />
        <label for="first-rate3" data-bs-toggle="tooltip" title="Good"
          >3 stars</label
        >
        <input type="radio" id="first-rate4" name="rating" value="4" />
        <label
          for="first-rate4"
          data-bs-toggle="tooltip"
          data-bs-placement="bottom"
          title="Very good"
          >4 stars</label
        >
        <input type="radio" id="first-rate5" name="rating" value="5" />
        <label for="first-rate5" data-bs-toggle="tooltip" title="Amazing"
          >5 stars</label
        >
      </fieldset>
      <div class="mb-3">
        <label for="comment" class="form-label">Review : </label>
        <textarea
          class="form-control"
          name="comment"
          id="comment"
          rows="3"
          required
        ></textarea>
      </div>
      <button class="btn btn-outline-secondary w-100">Add Review</button>
    </form>
    <% } else { %>
    <p>SignUp/LogIn to leave a review.</p>
    <% } %>
  </div>
  <hr />

  <div class="col-10 offset-1 mb-4">
    <h4>What Our Customers Felt</h4>
    <hr />
    <% if (list.reviews.length) { %> <% list.reviews.forEach(review => { %>

    <div class="card">
      <div class="card-body">
        <p
          class="card-text starability-result"
          data-rating="<%= review.rating %>"
        ></p>
        <p
          class="card-text"
          style="text-align: justify; font-size: 1.4rem; font-style: italic"
        >
          &#10075;&#10075; <%=review.comment %>
        </p>
        <% if(currUser && currUser._id.equals(list.owner._id) ){ %>
        <p class="card-text" style="font-size: 1.2rem">&#9758; You</p>
        <% } else { %>
        <p class="card-text" style="font-size: 1.2rem">
          &#9758; <%=review.author.username %>
        </p>
        <% } %> <% if(currUser && currUser._id.equals(review.author._id)) { %>
        <!-- Delete button triggers modal -->
        <button
          type="button"
          class="btn btn-outline-dark"
          data-bs-toggle="modal"
          data-bs-target="#confirmReviewDeleteModal-<%= review._id %>"
        >
          Delete
        </button>

        <!-- Modal -->
        <div
          class="modal fade"
          id="confirmReviewDeleteModal-<%= review._id %>"
          tabindex="-1"
          aria-labelledby="confirmReviewDeleteLabel-<%= review._id %>"
          aria-hidden="true"
        >
          <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-white text-black border-dark">
              <div class="modal-header border-0">
                <h5
                  class="modal-title"
                  id="confirmReviewDeleteLabel-<%= review._id %>"
                >
                  Confirm Delete Review
                </h5>
                <button
                  type="button"
                  class="btn-close"
                  data-bs-dismiss="modal"
                  aria-label="Close"
                ></button>
              </div>
              <div class="modal-body">
                Are you sure you want to delete this review? This action cannot
                be undone.
              </div>
              <div class="modal-footer border-0">
                <button
                  type="button"
                  class="btn btn-secondary"
                  data-bs-dismiss="modal"
                >
                  Cancel
                </button>
                <form
                  action="/lists/<%= list._id %>/reviews/<%= review._id %>"
                  method="POST"
                >
                  <button type="submit" class="btn btn-danger">
                    Yes, Delete
                  </button>
                </form>
              </div>
            </div>
          </div>
        </div>

        <% } %>
      </div>
    </div>
    <hr />
    <% }); } else {%>
    <p>No Reviews Yet.</p>
    <% } %>
  </div>
  <hr />
  <div class="col-10 offset-1 mb-4">
    <h4>Where You Will Be</h4>
    <hr />

    <div id="map" style="height: 400px; border-radius: 12px"></div>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const checkInInput = document.getElementById("checkIn");
      const checkOutInput = document.getElementById("checkOut");
      const nightsCountElement = document.getElementById("nightsCount");
      const subtotalElement = document.getElementById("subtotal");
      const gstAmountElement = document.getElementById("gstAmount");
      const totalPriceElement = document.getElementById("totalPrice");

      const basePrice = parseInt("<%= list.price %>");

      // Set default dates (today and tomorrow)
      const today = new Date();
      const tomorrow = new Date();
      tomorrow.setDate(tomorrow.getDate() + 1);

      checkInInput.valueAsDate = today;
      checkOutInput.valueAsDate = tomorrow;

      function updatePriceCalculations() {
        if (checkInInput.value && checkOutInput.value) {
          const checkIn = new Date(checkInInput.value);
          const checkOut = new Date(checkOutInput.value);

          if (checkOut > checkIn) {
            // Calculate number of nights
            const diffTime = Math.abs(checkOut - checkIn);
            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

            // Calculate prices
            const subtotal = basePrice * diffDays;
            const gstAmount = Math.round(subtotal * 0.18);
            const totalPrice = subtotal + gstAmount;

            // Update DOM elements
            nightsCountElement.textContent = diffDays;
            subtotalElement.textContent = `₹${subtotal.toLocaleString(
              "en-IN"
            )}`;
            gstAmountElement.textContent = `₹${gstAmount.toLocaleString(
              "en-IN"
            )}`;
            totalPriceElement.textContent = `₹${totalPrice.toLocaleString(
              "en-IN"
            )}`;

            // Add the total price as a hidden field to the form
            let hiddenTotalPrice = document.getElementById("hiddenTotalPrice");
            if (!hiddenTotalPrice) {
              hiddenTotalPrice = document.createElement("input");
              hiddenTotalPrice.type = "hidden";
              hiddenTotalPrice.id = "hiddenTotalPrice";
              hiddenTotalPrice.name = "totalPrice";
              document
                .getElementById("bookingForm")
                .appendChild(hiddenTotalPrice);
            }
            hiddenTotalPrice.value = totalPrice;
          }
        }
      }

      // Update price when dates change
      checkInInput.addEventListener("change", function () {
        // Ensure checkout date is after checkin date
        if (checkInInput.value) {
          const nextDay = new Date(checkInInput.value);
          nextDay.setDate(nextDay.getDate() + 1);
          checkOutInput.min = nextDay.toISOString().split("T")[0];

          // Reset checkout if it's before checkin
          if (
            checkOutInput.value &&
            new Date(checkOutInput.value) <= new Date(checkInInput.value)
          ) {
            nextDay.setDate(nextDay.getDate());
            checkOutInput.valueAsDate = nextDay;
          }
        }
        updatePriceCalculations();
      });

      checkOutInput.addEventListener("change", updatePriceCalculations);

      // Calculate initial prices
      updatePriceCalculations();
    });
  </script>
</body>

<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
<script>
  // Initialize the map
  document.addEventListener("DOMContentLoaded", function () {
    const address = `<%= list.location %>, <%= list.country %>`;

    // Call Nominatim to get coordinates
    const geocodeUrl = `https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(
      address
    )}`;

    fetch(geocodeUrl)
      .then((response) => response.json())
      .then((data) => {
        if (data.length === 0) {
          console.error("No results found for location:", address);
          document.getElementById("map").innerHTML =
            "<p>Location not found 😞</p>";
          return;
        }

        const lat = parseFloat(data[0].lat);
        const lon = parseFloat(data[0].lon);

        const map = L.map("map").setView([lat, lon], 10);

        L.tileLayer(
          `https://api.maptiler.com/maps/streets/{z}/{x}/{y}.png?key=<%= mapTilesApiKey %>`,
          {
            maxZoom: 19,
            attribution: "&copy; MapTiler & OpenStreetMap contributors",
          }
        ).addTo(map);

        L.marker([lat, lon])
          .addTo(map)
          .bindPopup(
            `Exact location will be provided after booking the spot 🤓`
          )
          .openPopup();
      })
      .catch((err) => {
        console.error("Geocoding error:", err);
        document.getElementById("map").innerHTML =
          "<p style='position: relative;top : 10px;left: 10px;'>Something went wrong loading the map 🥺</p>";
      });
  });
</script>
